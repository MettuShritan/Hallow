 
{
  "manifest_version": 3,
  "name": "Hallow — Behavioral Identity",
  "version": "1.0.0",
  "description": "AI-powered behavioral biometrics. Silently protects your identity in real time.",

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],

  "host_permissions": [
    "https://api.hallow.id/*",
    "https://cdn.jsdelivr.net/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/tf.min.js",
        "featureExtractor.js",
        "model.js",
        "trainer.js",
        "scorer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}