# ─────────────────────────────────────────────
#  Hallow Backend — Environment Variables
#  Copy this file to .env and fill in values
#  NEVER commit .env to git
# ─────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/hallow"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Email (Nodemailer — use Gmail or any SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Hallow Security <your@gmail.com>"

# SMS (Twilio — optional)
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_PHONE="+1234567890"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Extension origin
EXTENSION_ORIGIN="chrome-extension://your-extension-id"
